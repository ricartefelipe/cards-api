# Copie primeiro:   cp .env.example .env
# Preencha os campos em branco (ex.: openssl rand -hex 24). Nunca comite .env.
# Para demos locais alinhadas ao docker-compose.yml, passwords abaixo podem ser "cards"/"root".

# ---------- Runtime / Railway ----------
PORT=8080

# ---------- MariaDB (Compose) ----------
MARIADB_USER=cards
MARIADB_ROOT_PASSWORD=root
MARIADB_PASSWORD=cards

# ---------- Aplicação Quarkus ----------
DB_USERNAME=cards
DB_PASSWORD=cards
# Host: use localhost; no Compose o serviço cards-api usa o hostname "mysql"
DB_JDBC_URL=jdbc:mariadb://localhost:3306/cards_api?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=quarkus
# Igual ao "secret" do client backend-service em src/main/resources/quarkus-realm.json
# (portfolio-up.sh preenche automaticamente se ficar vazio)
KEYCLOAK_CLIENT_SECRET=

CARRIER_WEBHOOK_API_KEY=carrier-local-key
PROCESSOR_WEBHOOK_API_KEY=processor-local-key

CVV_DEFAULT_TTL_SECONDS=900

# ---------- Keycloak (bootstrap admin do container) ----------
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=admin
